# =========================================================
# CureLiynk medical assistant - environment
#
# Copy to .env and fill in. Never commit the real .env.
# =========================================================

# ---------------------------------------------------------
# API SECURITY  (required)
# ---------------------------------------------------------
#
# This service has no login of its own — the Node API owns sign-in. The two
# allowlists below are the whole perimeter, so fill them in before going live.

# "development" | "staging" | "production".
# Production hides /docs and refuses to start with a wildcard host or origin.
ENVIRONMENT=development

# Browser origins allowed to call this API, comma separated. The mobile app is
# NOT affected by this - native builds send no Origin header. This is for the
# Vite web frontend and Expo web.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Host header allowlist. Set this to your real domain before going live;
# "*" is only acceptable in development.
ALLOWED_HOSTS=*

# Requests allowed per client address per window. Each one costs an embedding
# pass, a rerank and at least one paid LLM call, so this is a bill control too.
# Everyone behind one NAT or carrier gateway shares a window, so size it for a
# shared address rather than for one phone.
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Longest symptom description accepted, in characters.
MAX_QUERY_CHARS=800

# ---------------------------------------------------------
# AI PROVIDERS  (required)
# ---------------------------------------------------------

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# ---------------------------------------------------------
# RETRIEVAL  (required)
# ---------------------------------------------------------

PINECONE_API_KEY=
PINECONE_INDEX_NAME=medical-knowledge
PINECONE_NAMESPACE=medical_knowledge

# ---------------------------------------------------------
# DOCTOR SEARCH  (required)
# ---------------------------------------------------------

# Google Places, used for the nearby-specialist search.
GOOGLE_MAPS_API_KEY=

# Optional alternative provider.
GEOAPIFY_API_KEY=

# Local doctor database, used when the maps search finds nobody in range.
MONGODB_URI=
MONGODB_DATABASE=medical_assistant
MONGODB_COLLECTION=doctors

# ---------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------

GROQ_API_KEY=
OLLAMA_MODEL=qwen3:4b
OLLAMA_HOST=http://localhost:11434
