# Base URL of the CureLiynk backend (server/). Defaults to localhost, which
# only reaches the API from a web build or an emulator with host networking.
# For a physical device or Expo Go, set this to your machine's LAN IP, e.g.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:5000
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000

# Base URL of the Python medical assistant (CureliynkMedical/backend), which
# powers the Ask AI chat. It is a separate service from the one above and
# listens on port 8000 by default. Same rule about localhost: a physical
# device or Expo Go needs your machine's LAN IP.
EXPO_PUBLIC_MEDICAL_API_BASE_URL=http://localhost:8000

# Google OAuth 2.0 client IDs (from Google Cloud Console > APIs & Services >
# Credentials). expo-auth-session needs the ones that match how the app is
# currently being run; only the Expo Go / web ones are required for local dev.
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
